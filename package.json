{
  "name": "weekend-warrior-club-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Weekend Warrior – Badminton Club Manager (WWCM)",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:static": "vite --mode static",
    "build": "tsc --noEmit && vite build",
    "build:static": "tsc --noEmit && vite build --mode static",
    "preview:static": "vite preview --mode static",
    "deploy": "node scripts/deploy-pages.mjs",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
